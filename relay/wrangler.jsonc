{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "seance-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  // ML-DSA in Web Crypto — a register's signature is verified with it
  // (shared/src/identity.ts). Opt-in while the Modern Algorithms draft settles.
  "compatibility_flags": ["webcrypto_modern_algorithms"],
  // Daemons dial wss://seance-relay.<subdomain>.workers.dev/daemon, the app /app.
  "workers_dev": true,
  // Off: a preview URL per uploaded version would keep superseded relays reachable
  // under the same BEARER_TOKEN, widening the surface for nothing this repo uses.
  "preview_urls": false,
  // Our console lines and uncaught exceptions only. Every frame is an invocation,
  // so invocation logs and traces each kept the per-frame timeline the relay's
  // own lines refuse, and a fetch entry adds the client's IP, location and TLS
  // fingerprint (DESIGN.md threat model item 3, M3 review S7). An uncaught
  // exception is its own `cf-worker` line, not part of the invocation entry.
  // Traces are written out as false so a compatibility-date bump, which is to
  // fold tracing into `enabled`, cannot turn them back on. To chase latency,
  // turn them on for one deploy, then off again.
  //
  // `redact_query_string`: the app authenticates with `?t=<bearer>` because a
  // browser cannot set a header on a WebSocket. Kept for that one-deploy trace,
  // whose fetch span stores the upgrade URL. Still no OTLP destination.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": false },
  },
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }],
  },
  // Sealed attachment objects (DESIGN.md, "Attachments"). The owner creates the
  // bucket and its 30-day lifecycle rule (README, setup); a deploy binding a
  // missing bucket fails.
  "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "seance-attachments" }],
  // Free-tier Durable Objects must be SQLite-backed.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  // BEARER_TOKEN is deliberately absent: it is a secret, not a var.
  //   deploy: bun run --cwd relay wrangler secret put BEARER_TOKEN
  //   local:  echo 'BEARER_TOKEN=...' > relay/.dev.vars   (gitignored)
  // So is SCHEDULER_LEADERS (device ids that may lead, comma-separated): not
  // secret, but a var here would be overwritten by every CI deploy. Unset, no
  // daemon is nominated and auto is unavailable.
  //   deploy: bun run --cwd relay wrangler secret put SCHEDULER_LEADERS
}
