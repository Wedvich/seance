{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "seance-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  // ML-DSA in Web Crypto — a register's signature is verified with it
  // (shared/src/identity.ts). Opt-in while the Modern Algorithms draft settles.
  "compatibility_flags": ["webcrypto_modern_algorithms"],
  // Daemons dial wss://seance-relay.<subdomain>.workers.dev/daemon, the app /app.
  "workers_dev": true,
  // Off: a preview URL per uploaded version would keep superseded relays reachable
  // under the same BEARER_TOKEN, widening the surface for nothing this repo uses.
  "preview_urls": false,
  // Our own lines only (DESIGN.md, threat model item 3). The relay logs failures
  // and refusals, never an accepted frame, because a line per frame is a timeline
  // of when each machine and app was active. Cloudflare's own telemetry would
  // keep that timeline anyway: an invocation log for every WebSocket message
  // and alarm (a time, the Durable Object, CPU and wall time), and a trace whose
  // storage spans name every key read or written — `store:task:<id>`,
  // `device:<id>` — so off go both. Console lines are logged unsampled.
  //
  // `redact_query_string`: the app authenticates with `?t=<bearer>` because a
  // browser cannot set a header on a WebSocket, and the upgrade's URL is in its
  // fetch's invocation log and trace. Traces stay off explicitly, not by
  // omission: Cloudflare plans to fold them into `enabled` with a later
  // compatibility date. To chase latency, turn them on with a
  // `head_sampling_rate` for a deploy, then off again — never an OTLP
  // destination while the token can still reach a URL.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": false },
  },
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }],
  },
  // Free-tier Durable Objects must be SQLite-backed.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  // BEARER_TOKEN is deliberately absent: it is a secret, not a var.
  //   deploy: bun run --cwd relay wrangler secret put BEARER_TOKEN
  //   local:  echo 'BEARER_TOKEN=...' > relay/.dev.vars   (gitignored)
  // So is SCHEDULER_LEADERS (device ids that may lead, comma-separated): not
  // secret, but a var here would be overwritten by every CI deploy. Unset, no
  // daemon is nominated and auto is unavailable.
  //   deploy: bun run --cwd relay wrangler secret put SCHEDULER_LEADERS
}
