# Relay the app dials, and the only non-self origin allowed by the built CSP.
# Required for `vite build`; `vite dev` falls back to the local wrangler dev port.
# The <subdomain> is your Cloudflare account's, printed by the relay's first deploy.
VITE_RELAY_URL=wss://seance-relay.<subdomain>.workers.dev/app
