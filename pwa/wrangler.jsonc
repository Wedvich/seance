{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "seance-pwa",
  "compatibility_date": "2026-07-27",
  // Assets only, no "main": there is no server side. Headers come from dist/_headers,
  // which vite.config.ts generates so the CSP can carry the boot script's hash.
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
