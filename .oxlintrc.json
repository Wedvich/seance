{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "react"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "warn"
  },
  "env": {
    "builtin": true,
    "es2024": true
  },
  "ignorePatterns": ["node_modules", "dist"],
  "rules": {
    "import/max-dependencies": "off",
    // Stylesheets are imported for their side effect; there is nothing to assign.
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],
    "max-classes-per-file": "off",
    "max-lines": "off",
    "max-lines-per-function": "off",
    "no-inline-comments": "off",
    "no-negated-condition": "off",
    "promise/always-return": ["error", { "ignoreLastCallback": true }],
    "promise/no-multiple-resolved": "off",
    // React Compiler rules (oxlint 1.8x). The pwa is Preact and the raycast ref-mirror
    // pattern (`ref.current = value` in render) is deliberate; no compiler runs here.
    "react/immutability": "off",
    "react/no-unescaped-entities": "off",
    "react/purity": "off",
    "react/refs": "off",
    "react/react-in-jsx-scope": "off",
    "require-await": "off",
    // Closures sit beside their one use on purpose (tests, MCP tool handlers); hoisting trades locality for nothing.
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-callback-reference": "off",
    "unicorn/no-negated-condition": "off",
    "unicorn/no-useless-spread": "off",
    "unicorn/no-useless-undefined": "off",
    "unicorn/prefer-code-point": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/test/**"],
      "rules": {
        "no-await-in-loop": "off"
      }
    }
  ]
}
